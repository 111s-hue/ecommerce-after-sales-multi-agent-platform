APP_NAME=LangGraph 电商售后多智能体平台
ENVIRONMENT=development
APP_VERSION=1.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
REQUEST_ID_HEADER=X-Request-ID
DATABASE_URL=sqlite:///./data/mysystem.db
SEED_DEMO_DATA=true
REDIS_URL=redis://localhost:6379
USE_REDIS_CHECKPOINT=false
TOOL_TRANSPORT=local
MCP_SERVER_URL=http://localhost:8002/mcp
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8002
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3-8B-Instruct
LLM_ENABLED=false
LLM_TIMEOUT_SECONDS=30
MAX_AGENT_STEPS=3
RAG_BACKEND=hybrid-lite
RAG_TOP_K=4
BGE_MODEL=BAAI/bge-m3
POLICY_DIR=./data/policies
FAISS_INDEX_DIR=./data/indexes
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=after_sales_policies
KNOWLEDGE_TENANT_ID=demo
EVALUATION_REPORT_PATH=./data/evaluation/latest.json
MAX_KNOWLEDGE_UPLOAD_BYTES=2097152
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENABLED=false
MINIO_BUCKET=after-sales-kb
AUTH_ENABLED=true
JWT_SECRET=change-this-32-byte-secret-in-production
ACCESS_TOKEN_MINUTES=120
JWT_ISSUER=after-sales-platform
JWT_AUDIENCE=after-sales-console
DEFAULT_TENANT_CODE=community
ALLOWED_HOSTS=["127.0.0.1","localhost","10.2.0.2"]
